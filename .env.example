# All optional — the journal boots with none of these set.

# Session signing key for Better Auth (per-user accounts). Required once you
# deploy beyond localhost — falls back to an insecure published default
# otherwise, which Better Auth refuses to use in production.
# Default: reuses JOURNAL_SECRET below if set, otherwise an insecure default.
# BETTER_AUTH_SECRET=

# The site's own canonical URL, e.g. https://www.example.com — used to build
# OAuth callback URLs and validate the request origin. Recommended in any
# real deployment; without it the origin is derived from each request.
# BETTER_AUTH_URL=

# Google sign-in (optional, in addition to email+password). Both must be set
# together or neither is used. Register this exact redirect URI in Google
# Cloud Console: {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email used for the one-time account created from any pre-existing
# single-user data on first boot after upgrading to per-user accounts.
# Default: admin@localhost
# JOURNAL_LEGACY_EMAIL=

# Require a password to open the journal (recommended when exposed beyond localhost).
# Also used, once, as that one-time legacy account's password if it's set
# when the legacy migration above first runs.
# JOURNAL_PASSWORD=

# Encryption key source for broker credentials at rest.
# Default: a random key file generated next to the database.
# JOURNAL_SECRET=

# Where the SQLite database lives. Default: ./data
# JOURNAL_DATA_DIR=

# AI features (session recaps, trade critiques, ask-your-journal).
# Can also be set on the Settings page (stored encrypted).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# If only OPENAI_API_KEY is set, OpenAI is selected automatically.
# If both keys are set, Anthropic stays the default until you choose a provider in Settings.
# Provider and model choices are saved in Settings; environment keys take precedence over saved keys.

# Optional market data: no provider is configured or enabled by this template.
# Choose a connection or upload candle CSVs in Settings > Market data.
# Provider-specific environment configuration is documented in docs/market-data.md.

# Payments (Midtrans Snap). Without both keys the Billing page shows plans but
# checkout is disabled. Keys come from dashboard.midtrans.com → Settings →
# Access Keys for the environment selected there (Sandbox or Production).
# Leave MIDTRANS_IS_PRODUCTION unset while testing with sandbox keys; set it to
# "true" together with production keys to take real payments.
# Also set, in the same dashboard: Settings → Payment → Notification URL =
#   {BETTER_AUTH_URL}/api/billing/notification
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=

# Monthly AI calls during the free trial (paid plans use PRO_AI_QUOTA /
# ELITE_AI_QUOTA). Default: 10
# TRIAL_AI_QUOTA=

# Transactional email (verification + password reset) via Resend's HTTP API.
# Without RESEND_API_KEY, emails are printed to the server log instead and
# email verification is NOT required (so signups keep working). Once set,
# new signups must verify; accounts that existed before are auto-verified on
# the first boot with it set. Verify the sender's domain in Resend first
# (Domains → add mndjournal.com's DNS records), or sends are rejected.
# RESEND_API_KEY=
# Default: mndjournal <no-reply@mndjournal.com>
# EMAIL_FROM=
